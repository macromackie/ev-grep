#!/usr/bin/env -S uv run --script
# MISE description="Send a packaged binary's search to local HTTPS and plain-HTTP fake providers"
# USAGE arg "<binary>" help="The ev-grep binary to run"
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Verify packaged TLS roots with `mise run release:smoke <binary>` and local fake providers."""

import sys
from pathlib import Path


def main() -> None:
    """Compose the standalone smoke program without installing a package."""
    library = Path(__file__).resolve().parents[1] / "lib"

    sys.path.insert(0, str(library))

    from release import errors, exit_status, output, run, settings

    try:
        report = run.run(binary=settings.read_binary())
    except errors.SmokeFailed as error:
        output.finish(error=str(error), report=(), status=exit_status.ExitStatus.FAILED)

    output.finish(report=report, status=exit_status.ExitStatus.PASSED)


if __name__ == "__main__":
    main()
